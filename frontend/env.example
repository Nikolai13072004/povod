# POVOD frontend — build-time переменные Vite.
# Скопируйте файл в `.env.local` для локальной разработки.

# Абсолютный URL backend API. Допустимы только HTTP(S); завершающий `/`
# нормализуется автоматически.
VITE_API_URL=http://localhost:8080/

# Показывает локальные демо-данные входа. В production всегда `false`.
VITE_DEMO_AUTH_ENABLED=true
