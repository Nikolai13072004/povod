{
  "id": "/",
  "name": "POVOD — планирование встреч",
  "short_name": "POVOD",
  "description": "Собирайте друзей на встречи без долгих переписок: создайте повод, пригласите одним кликом и следите, кто идёт.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#ebf2fa",
