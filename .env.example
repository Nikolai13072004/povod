# Docker Compose development environment. Copy to `.env` to override defaults.

POSTGRES_DB=povod
POSTGRES_USER=povod
POSTGRES_PASSWORD=povod_local_password

BACKEND_PORT=8080
FRONTEND_PORT=5173
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AUTH_SESSION_DAYS=30
ENABLE_EXTERNAL_EVENTS=false

DEMO_AUTH_ENABLED=true
DEMO_AUTH_PASSWORD=povod-demo

# Browser-visible URL embedded into the frontend build.
VITE_API_URL=http://localhost:8080/
VITE_DEMO_AUTH_ENABLED=true

# Optional VK Mini Apps adapter settings. Never commit real secrets in `.env.example`.
VK_APP_ID=
VK_APP_SECRET=
