# =================================================================================
# POVOD backend — переменные окружения
# =================================================================================
# Скопируй в .env и при необходимости поправь. Значения валидируются при запуске;
# небезопасные production-настройки останавливают старт с понятной ошибкой.

# Порт HTTP-сервера
PORT=8080

# Интерфейс прослушивания
HOST=0.0.0.0

# CORS origin: "*" для разработки, конкретный домен фронта для прода
#   например: https://team-5.hack.kam-dev.ru
CORS_ORIGIN=*

# Персистентность данных в data/db.json:
#   true  — пережимать изменения на диск (по умолчанию локально)
#   false — чистый in-memory, пересев при каждом старте
PERSIST=true

# Постоянное хранилище в PostgreSQL. Если задано — данные переживают рестарты
# (Render Free сбрасывает память/диск). Подходит бесплатный Neon/Supabase/Render Postgres.
# Если пусто — используется PERSIST выше. Пример:
#   DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# TLS для PostgreSQL: auto (по умолчанию), true или false.
# Для Docker Compose используется false: соединение идёт по внутренней сети контейнеров.
DATABASE_SSL=auto

# Имя сервиса (отдаётся в /health и /api/ping)
SERVICE_NAME=povod-backend

NODE_ENV=development

# --- Аутентификация ---
# Срок жизни отзываемой серверной сессии.
AUTH_SESSION_DAYS=30

# Куки браузерной сессии (см. docs/decisions/SEC-001-cookie-sessions.md).
# SameSite: lax/strict — фронт и API на одном сайте (в т.ч. разные порты localhost
# или поддомены одного домена); none — только для настоящего cross-site, нужен HTTPS.
AUTH_COOKIE_SAMESITE=lax
# Secure: auto (включается в production), true или false.
AUTH_COOKIE_SECURE=auto
# Домен куки — задать, если она должна действовать на поддоменах (.povod.example).
AUTH_COOKIE_DOMAIN=

# Адрес приложения: из него собираются ссылки в письмах (восстановление пароля).
APP_URL=http://localhost:5173

# Транспорт писем:
#   console — печатает письмо в лог (только для разработки);
#   none    — восстановление пароля отключено, endpoint отвечает 503;
#   resend  — отправка через resend.com, нужны RESEND_API_KEY и MAIL_FROM;
#   smtp    — обычный SMTP личного ящика (Яндекс, Gmail), домен не нужен;
#   brevo   — HTTP API brevo.com: домен не нужен, подтверждается один адрес
#             отправителя. Единственный рабочий вариант там, где хостинг
#             закрывает SMTP-порты (Render на бесплатном тарифе — как раз такой).
#
# Про выбор. Своего домена нет — берите brevo: resend без подтверждённого
# домена доставляет письма ТОЛЬКО владельцу аккаунта, а smtp не работает там,
# где хостинг закрывает порты (бесплатный Render — как раз такой случай).
# В production значение console запрещено проверкой конфигурации: иначе
# пользователь видит «письмо отправлено», а ссылка уходит в лог сервера.
MAIL_TRANSPORT=console

# Ключ API Resend (resend.com → API Keys). НЕ коммитить реальное значение!
RESEND_API_KEY=

# Ключ API Brevo (app.brevo.com → SMTP & API → API Keys). Отправитель в MAIL_FROM
# должен быть подтверждён в разделе Senders. НЕ коммитить реальное значение!
BREVO_API_KEY=
# Отправитель: user@example.com либо «Имя <user@example.com>».
# Пока домен не подтверждён в Resend, письма уходят только на адрес владельца
# аккаунта, а отправителем разрешён onboarding@resend.dev.
# Для smtp адрес обязан совпадать с SMTP_USER: почтовые провайдеры отклоняют
# чужого отправителя.
MAIL_FROM=

# --- SMTP (MAIL_TRANSPORT=smtp) ---
# Яндекс:  smtp.yandex.ru,  порт 465, SMTP_SECURE=true
# Gmail:   smtp.gmail.com,  порт 465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
# true — TLS с первого байта (465); false — STARTTLS (587).
SMTP_SECURE=true
# Полный адрес ящика.
SMTP_USER=
# ПАРОЛЬ ПРИЛОЖЕНИЯ, а не пароль от почты: обычный пароль оба провайдера для
# SMTP не принимают. НЕ коммитить реальное значение!
SMTP_PASSWORD=
# Демо-вход создаётся только для локальной разработки. В production держать false.
DEMO_AUTH_ENABLED=true
DEMO_AUTH_PASSWORD=povod-demo

# --- VK Mini Apps ---
# Защищённый ключ приложения VK (из настроек приложения на vk.com/dev).
# Если задан — бэкенд проверяет подпись launch-параметров (sign) на /api/Auth/vk.
# Если пусто — подпись не проверяется только в dev; в production VK-вход вернёт 503.
# НЕ коммитить реальное значение!
VK_APP_SECRET=
# ID приложения VK (необязательно, для справки/будущих проверок)
VK_APP_ID=

# Подмешивать каталог KudaGo в публичную ленту.
ENABLE_EXTERNAL_EVENTS=true
